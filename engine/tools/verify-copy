#!/usr/bin/env bash
# engine/tools/verify-copy: in a game repo, check that engine/ is exactly what vendor-engine wrote
# (no edited, missing or extra files). Engine fixes belong in the rpgmaker-web-engine repo.
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ ! -f MANIFEST.sha256 ]]; then
    echo "verify-copy: engine/MANIFEST.sha256 missing; run scripts/vendor-engine from the engine repo" >&2
    exit 1
fi
sha256sum --quiet -c MANIFEST.sha256
extra=$(comm -13 <(cut -c67- MANIFEST.sha256 | LC_ALL=C sort) \
    <(find . -type f ! -name VERSION ! -name MANIFEST.sha256 ! -path '*/__pycache__/*' -printf '%P\n' | LC_ALL=C sort))
if [[ -n "$extra" ]]; then
    echo "verify-copy: files in engine/ that the engine repo does not have: $extra" >&2
    exit 1
fi
echo "verify-copy: engine $(cut -c1-12 VERSION) intact"
