#!/usr/bin/env bash
# scripts/check: the single validation gate (pre-push hook and CI run it).
# Engine and game tests use node's built-in runner, converter tests use unittest, then the
# clean-code audit.
set -euo pipefail
cd "$(dirname "$0")/.."
node --test "tests/*.test.mjs"
python3 -m unittest discover -s tests -p "test_*.py"
scripts/clean-code-audit --strict
